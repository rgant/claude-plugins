{
  "description": "STE writing checks: a reminder on each prompt, a lint report after each write, and a gate on gh and acli bodies.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python \">=3.14\" \"${CLAUDE_PLUGIN_ROOT}/hooks/writing-reminder-hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python \">=3.14\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ste-gh-body-hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python \">=3.14\" \"${CLAUDE_PLUGIN_ROOT}/hooks/ste-lint-hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
